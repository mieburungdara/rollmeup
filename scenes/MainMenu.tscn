visible = false
exclusive = true

[node name="EditorMapPopup" type="Window" parent="."]
title = "Map Editor - Choose Template"
initial_position = 2
size = Vector2i(350, 250)
visible = false
exclusive = true

[node name="Panel" type="PanelContainer" parent="EditorMapPopup"]
anchors_preset = 15

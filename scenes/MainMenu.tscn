[node name="QuitBtn" type="Button" parent="VBox"]
custom_minimum_size = Vector2(0, 50)
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.5, 0.5, 1)
theme_override_styles/normal = SubResource("StyleBoxFlat_Normal")
theme_override_styles/hover = SubResource("StyleBoxFlat_Hover")
theme_override_styles/pressed = SubResource("StyleBoxFlat_Pressed")
text = "Exit"

[node name="AboutPopup" type="AcceptDialog" parent="."]
title = "About"
initial_position = 2
size = Vector2i(300, 150)
dialog_text = "Payon Village Simulation.
A fixed map simulation game."

[node name="MapSizePopup" type="Window" parent="."]
title = "New Game - Choose Map"
